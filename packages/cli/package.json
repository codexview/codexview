{
  "name": "@codexview/cli",
  "version": "0.7.1",
  "description": "CLI that renders AI coding agent transcript logs (Codex exec JSONL and rollouts, codex-team, Claude Code, OpenCode, GitHub Copilot) as compact plaintext markdown. Wraps @codexview/adapters.",
  "keywords": [
    "ai",
    "agent",
    "transcript",
    "codex",
    "claude-code",
    "markdown",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Jay Liu (maxazure) <maxazure@gmail.com>",
  "homepage": "https://github.com/codexview/codexview#readme",
  "bugs": "https://github.com/codexview/codexview/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexview/codexview.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codexview/adapters": "workspace:*"
  },
  "bin": {
    "codexview-md": "./bin/codexview-md.mjs"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
