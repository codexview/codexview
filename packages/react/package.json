{
  "name": "@codexview/react",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "React components for AI coding agent transcripts and interactive Codex sessions. Supports Codex CLI, AgentWeb codex-team, Claude Code, OpenCode, and GitHub Copilot through @codexview/adapters.",
  "keywords": [
    "ai",
    "agent",
    "transcript",
    "viewer",
    "react",
    "codex",
    "claude-code",
    "opencode",
    "rollout",
    "chat"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Jay Liu (maxazure) <maxazure@gmail.com>",
  "homepage": "https://github.com/codexview/codexview#readme",
  "bugs": "https://github.com/codexview/codexview/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexview/codexview.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config dev/vite.config.ts",
    "playground": "vite --config playground/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@codexview/runtime": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codexview/adapters": "workspace:*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
