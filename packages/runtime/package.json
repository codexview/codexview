{
  "name": "@codexview/runtime",
  "version": "0.7.0",
  "description": "Node.js Codex app-server session runtime for CodexView",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@codexview/adapters": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexview/codexview.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/codexview/codexview/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/codexview/codexview/issues"
}
